{
  "name": "spillway-scaler",
  "private": true,
  "description": "Launches one-job GCE Spot VMs as just-in-time GitHub Actions runners when jobs queue, and cleans them up.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@google-cloud/compute": "^7.5.0",
    "@google-cloud/tasks": "^7.2.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  },
  "license": "Apache-2.0"
}
